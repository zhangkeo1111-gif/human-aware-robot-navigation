#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "husky_a300"
    doc = """Generated from Composed Stage of root layer C:\\Users\\86166\\AppData\\Local\\Temp\\tmpi7ftrf83\\husky_a300.usdc


Generated from Composed Stage of root layer C:\\Users\\86166\\AppData\\Local\\Temp\\urdf_import_husky_a300_gy43zj2p\\usdex_husky_a300\\husky_a300.usdc


Generated from Composed Stage of root layer C:\\Users\\86166\\AppData\\Local\\Temp\\urdf_import_husky_a300_gy43zj2p\\temp_husky_a300\\husky_a300.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "husky_a300" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </husky_a300/Physics/front_left_wheel_joint>,
        </husky_a300/Physics/front_right_wheel_joint>,
        </husky_a300/Physics/rear_left_wheel_joint>,
        </husky_a300/Physics/rear_right_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </husky_a300/Geometry/base_link>,
        </husky_a300/Geometry/base_link/front_left_wheel_link>,
        </husky_a300/Geometry/base_link/front_right_wheel_link>,
        </husky_a300/Geometry/base_link/rear_left_wheel_link>,
        </husky_a300/Geometry/base_link/rear_right_wheel_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "front_left_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_right_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_left_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_right_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "front_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

